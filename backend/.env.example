# Server Configuration
NODE_ENV=development
PORT=5000

# Frontend URL (used for email verification links)
FRONTEND_URL=http://localhost:3000

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_db_password
DB_NAME=jobtracker

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Email Configuration (for email verification)
# For development, you can use Ethereal.email (https://ethereal.email/)
EMAIL_FROM="Job Tracker <noreply@jobtracker.com>"
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_SECURE=false # true for 465, false for other ports
EMAIL_USER=your_ethereal_email
EMAIL_PASSWORD=your_ethereal_password

# Seed Data (optional)
SEED_EMAIL=admin@example.com
SEED_PASSWORD=ChangeMe123!
